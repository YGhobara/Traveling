<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/travel_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mes Groupes"
                android:textColor="@color/travel_on_background"
                android:textSize="24sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonCreateGroup"
                style="@style/Widget.Material3.Button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textSize="24sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/textGroupsStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Chargement des groupes..."
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textMyGroupsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Mes groupes"
            android:textColor="@color/travel_on_background"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMyGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/textDiscoverGroupsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Découvrir des groupes publics"
            android:textColor="@color/travel_on_background"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDiscoverGroups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/textGuestHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_post_placeholder"
            android:padding="14dp"
            android:text="Connectez-vous pour créer ou rejoindre des groupes."
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>